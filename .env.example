# PostgreSQL + pgvector. Defaults match docker-compose.yml.
DATABASE_URL=postgres://rag:rag@localhost:5432/rag

# Local open-weight embeddings (ONNX port of sentence-transformers/all-MiniLM-L6-v2).
# Run `npm run rag:model:download` once to populate this local directory.
# Alternatively, use the Hugging Face model ID and let Transformers.js download at runtime:
# RAG_EMBEDDING_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX
RAG_EMBEDDING_MODEL=.cache/transformers/onnx-community/all-MiniLM-L6-v2-ONNX
RAG_EMBEDDING_DIMENSIONS=384
RAG_MODEL_CACHE_DIR=.cache/transformers

# Deterministic chunking and retrieval defaults.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# Python/Crawl4AI ingestion worker. Use `python3` instead if the venv is activated.
RAG_PYTHON_BIN=worker/.venv/bin/python
RAG_CRAWLER_SCRIPT=worker/crawl4ai_crawl.py
RAG_CRAWL_TIMEOUT_MS=300000
